<!doctype html>
<html lang="sv">
<head>
  <meta charset="utf-8" />
  <title><%= movie.title %></title>
</head>
<body>
  <h1><%= movie.title %></h1>
  <% if (movie.imageUrl) { %>
    <img src="<%= movie.imageUrl %>" alt="<%= movie.title %>" style="max-width:420px;" />
  <% } %>
  <p><%= movie.intro %></p>
  <p><a href="/movies">Tillbaka till listan</a></p>
</body>
</html>
